{
  "name": "@motuscap-lite/desktop",
  "productName": "MotusCap Lite",
  "version": "0.1.0",
  "private": true,
  "description": "MotusCap Lite — desktop operator app for synced multi-phone capture and per-camera pose",
  "license": "UNLICENSED",
  "author": {
    "name": "MotusCap Lite"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "mediapipe:assets": "node scripts/fetch-mediapipe.mjs",
    "ffmpeg:assets": "node scripts/fetch-ffmpeg.mjs",
    "start": "pnpm mediapipe:assets && pnpm ffmpeg:assets && electron-forge start",
    "package": "pnpm mediapipe:assets && pnpm ffmpeg:assets && electron-forge package",
    "make": "pnpm mediapipe:assets && pnpm ffmpeg:assets && electron-forge make",
    "make:win": "pnpm mediapipe:assets && node scripts/fetch-ffmpeg.mjs --platform=win32 --arch=x64 && electron-forge make --platform=win32",
    "make:mac": "pnpm mediapipe:assets && pnpm ffmpeg:assets && electron-forge make --platform=darwin",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "electron-winstaller": "^5.4.4",
    "ffmpeg-static": "^5.3.0",
    "glob": "7.2.3",
    "happy-dom": "^21.0.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "selfsigned": "^5.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron-winstaller",
      "ffmpeg-static"
    ]
  }
}
